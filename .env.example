ENV=local

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b-instruct-q4

LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3

DB_URL=postgresql+psycopg://cv_user:secret@localhost:5432/candidate_screening
DB_ECHO=true

VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=./data/vectorstore

RAG_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

ENABLE_RERANK=true
ENABLE_CHAT_MEMORY=true